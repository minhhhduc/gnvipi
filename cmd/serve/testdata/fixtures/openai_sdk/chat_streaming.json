{
  "model": "gpt-4o",
  "stream": true,
  "stream_options": {
    "include_usage": true
  },
  "messages": [
    {
      "role": "system",
      "content": "You are a code refactoring assistant."
    },
    {
      "role": "user",
      "content": "Refactor this function to be more idiomatic."
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "run_linter",
        "description": "Run linter on code snippet",
        "parameters": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            }
          },
          "required": [
            "code"
          ]
        }
      }
    }
  ],
  "tool_choice": "auto",
  "parallel_tool_calls": true,
  "temperature": 0.5
}
