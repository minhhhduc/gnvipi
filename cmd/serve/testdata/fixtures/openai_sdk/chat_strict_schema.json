      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "year": {
            "type": "integer"
          }
        },
        "required": [
          "people",
          "cities",
          "year"
        ],
        "additionalProperties": false
      }
    }
  }
